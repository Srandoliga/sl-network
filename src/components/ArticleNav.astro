---
// Konec článku: předchozí / následující vydání stejné rubriky (jen pravidelné rubriky) a nejvýš dva související
// články s doloženou souvislostí. Jen publikovaný obsah; když nic nesouvisí, blok se nezobrazí.
import SectionHead from './SectionHead.astro';
import { categoryLabel } from '../lib/site.js';
import { formatDateCs, isoDate } from '../lib/articles.js';
import { u } from '../lib/paths';
interface Props { prev?: any; next?: any; related?: any[]; category: string }
const { prev, next, related = [], category } = Astro.props;
const label = categoryLabel(category);
---
{(prev || next) && (
  <nav class="series-nav" aria-label={`Další vydání: ${label}`}>
    {prev ? (
      <a class="series-nav__link series-nav__link--prev" href={u(`clanky/${prev.id}/`)}>
        <span class="series-nav__dir">← Předchozí {label}</span>
        <span class="series-nav__title">{prev.data.title}</span>
        <time class="series-nav__date" datetime={isoDate(prev.data.date)}>{formatDateCs(prev.data.date)}</time>
      </a>
    ) : <span class="series-nav__empty">První vydání rubriky</span>}
    {next ? (
      <a class="series-nav__link series-nav__link--next" href={u(`clanky/${next.id}/`)}>
        <span class="series-nav__dir">Další {label} →</span>
        <span class="series-nav__title">{next.data.title}</span>
        <time class="series-nav__date" datetime={isoDate(next.data.date)}>{formatDateCs(next.data.date)}</time>
      </a>
    ) : <span class="series-nav__empty">Nejnovější vydání</span>}
  </nav>
)}
{related.length > 0 && (
  <section class="stack related" aria-labelledby="related-title">
    <SectionHead title="Související" accent="články" href="clanky/" linkLabel="Všechny" />
    <ul class="team-articles">
      {related.map((a) => (
        <li><a href={u(`clanky/${a.id}/`)}>
          <span class="team-articles__meta">{categoryLabel(a.data.category)} · <time datetime={isoDate(a.data.date)}>{formatDateCs(a.data.date)}</time></span>
          <span class="team-articles__title" id={a === related[0] ? 'related-title' : undefined}>{a.data.title}</span>
        </a></li>
      ))}
    </ul>
  </section>
)}
