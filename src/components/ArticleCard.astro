---
// Karta článku s obrázkem (vlastní `image`, jinak obrázek rubriky) a portrétem autora.
import StaffAvatar from './StaffAvatar.astro';
import { staffById } from '../lib/data.js';
import { categoryLabel } from '../lib/site.js';
import { coverImage, formatDateCs, isoDate } from '../lib/articles.js';
import { u } from '../lib/paths';
import { asset } from '../lib/assets';
interface Props {
  article: { id: string; data: { title: string; perex: string; author: string; category: string; date: Date; draft: boolean; demo: boolean; image?: string; imageAlt?: string } };
  showPerex?: boolean;
}
const { article, showPerex = true } = Astro.props;
const { title, perex, author, category, date, draft, demo, image, imageAlt } = article.data;
const person = staffById(author);
const cover = coverImage({ image, category });
---
<article class="card card--cover">
  <img class="card__image" src={asset(cover)} alt={image ? imageAlt ?? '' : ''} width="1536" height="1024" loading="lazy" decoding="async" />
  <div class="card__body">
    <div class="card__meta">
      <span class="tag">{categoryLabel(category)}</span>
      {draft && <span class="tag tag--draft">Koncept</span>}
      {demo && <span class="tag tag--demo">DEMO</span>}
    </div>
    <h3 class="card__title"><a href={u(`clanky/${article.id}/`)}>{title}</a></h3>
    {showPerex && <p class="card__perex">{perex}</p>}
    <div class="card__byline">
      {person && <span class="card__face"><StaffAvatar id={person.avatar} /></span>}
      <span>{person?.shortName} · <time datetime={isoDate(date)}>{formatDateCs(date)}</time></span>
    </div>
  </div>
</article>
