---
// Výpis článků s filtrem kategorií (statické stránky, bez JavaScriptu).
import ArticleCard from './ArticleCard.astro';
import EmptyState from './EmptyState.astro';
import { CATEGORIES } from '../lib/site.js';
import { u } from '../lib/paths';
interface Props { articles: any[]; current?: string; heading: string }
const { articles, current, heading } = Astro.props;
---
<h1 class="page-title">{heading}</h1>
<nav class="chips" aria-label="Kategorie">
  <a class="chip" href={u('clanky/')} aria-current={!current ? 'page' : undefined}>Vše</a>
  {CATEGORIES.map((c) => <a class="chip" href={u(`clanky/kategorie/${c.id}/`)} aria-current={current === c.id ? 'page' : undefined}>{c.label}</a>)}
</nav>
{articles.length
  ? <ul class="article-list article-list--grid">{articles.map((a) => <li><ArticleCard article={a} /></li>)}</ul>
  : <EmptyState title="Tady zatím nic není" text="Redakce na tom pracuje. Nebo aspoň tvrdí, že na tom pracuje." icon="📝" />}
