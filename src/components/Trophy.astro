---
// Pohár – symbol titulu (zlatá je vyhrazená pro tituly a ocenění).
interface Props { muted?: boolean }
const id = `tg${Math.random().toString(36).slice(2, 8)}`;
const [light, dark] = Astro.props.muted ? ['#4b515b', '#2a2e35'] : ['#f5d27a', '#b8862a'];
---
<svg viewBox="0 0 40 48" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color={dark} /><stop offset=".45" stop-color={light} /><stop offset="1" stop-color={dark} />
    </linearGradient>
  </defs>
  <path d="M9 4h22v10c0 7-5 12-11 12S9 21 9 14z" fill={`url(#${id})`} />
  <path d="M9 7H3v4c0 5 3 8 7 9M31 7h6v4c0 5-3 8-7 9" fill="none" stroke={`url(#${id})`} stroke-width="2.5" />
  <path d="M17 26h6v7h-6z" fill={dark} />
  <path d="M11 33h18l2 6H9z" fill={`url(#${id})`} />
  <rect x="7" y="39" width="26" height="6" rx="1.5" fill={dark} />
  <path d="M14 7c0 6 1 10 4 13" stroke="#fff" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
</svg>
