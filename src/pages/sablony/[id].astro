---
import Base from '../../layouts/Base.astro';
import MessengerCard from '../../components/MessengerCard.astro';
import { templates } from '../../lib/data.js';
import { u } from '../../lib/paths';
export function getStaticPaths() {
  return templates.map((template) => ({ params: { id: template.id }, props: { template } }));
}
const { template } = Astro.props;
---
<Base title={`Šablona: ${template.name}`}>
  <p style="margin:0 0 12px"><a href={u('sablony/')}>← Všechny šablony</a></p>
  <MessengerCard template={template} />
  <details class="panel" style="margin-top:20px">
    <summary><strong>Jak uložit jako obrázek</strong></summary>
    <ol>
      <li><strong>Telefon:</strong> snímek obrazovky, pak oříznout na rámeček šablony.</li>
      <li><strong>Chrome na počítači:</strong> pravým tlačítkem na šablonu → Prozkoumat → na označeném prvku pravým tlačítkem → <em>Capture node screenshot</em> (vznikne PNG).</li>
    </ol>
    {template.demo && <p><strong>Pozor:</strong> šablona obsahuje DEMO údaje. Před sdílením je přepište skutečnými daty.</p>}
  </details>
</Base>
