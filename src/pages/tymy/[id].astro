---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import TeamIcon from '../../components/TeamIcon.astro';
import TitleBadge from '../../components/TitleBadge.astro';
import EmptyState from '../../components/EmptyState.astro';
import { teams, seasons, rivalries, teamById } from '../../lib/data.js';
import { teamHistory } from '../../lib/history.js';
import { u } from '../../lib/paths';

export function getStaticPaths() {
  return teams.map((team) => ({ params: { id: team.id }, props: { team } }));
}
const { team } = Astro.props;
const history = teamHistory(seasons, team.id);
const titles = history.filter((h) => h.result === 'champion');
const teamRivalries = rivalries.filter((r) => r.teams.includes(team.id));
const statusLabel = { active: 'Pokračující franšíza', new: 'Nováček Sezony V', former: 'Už nehrají – součást historie' }[team.status];
---
<Base title={team.name} description={team.story}>
  <div class="stack">
    <header class="team-hero" style={`--team:${team.color}`}>
      <TeamIcon team={team} decorative={false} />
      <div>
        <p class="kicker" style="margin:0 0 4px">{statusLabel}</p>
        <h1 class="page-title" style="font-size:clamp(1.9rem,8vw,3rem)">{team.name}</h1>
        {!team.verified && <span class="tag tag--muted">Název zatím nepotvrzen majitelem</span>}
        {titles.length > 0 && <p style="margin:8px 0 0"><TitleBadge label={`${titles.length}× šampion`} /></p>}
      </div>
    </header>

    <section class="panel">
      <p class="kicker" style="margin:0 0 6px">Mediální příběh</p>
      <p style="margin:0;font-family:var(--font-serif);font-size:1.15rem">{team.story}</p>
    </section>

    <section class="stack">
      <SectionHead title="Finálová" accent="historie" />
      {history.length
        ? <ul class="stack" style="list-style:none;padding:0;margin:0">{history.map((h) => {
            const opp = teamById(h.opponent);
            return (
              <li class="stripe-row" style={`--team:${h.result === 'champion' ? 'var(--gold)' : 'var(--border)'}`}>
                <strong>{h.season}</strong>
                {h.result === 'champion' ? <TitleBadge label="Šampion" /> : <span class="tag tag--outline">Finalista</span>}
                <span class="byline__role">vs. <a href={u(`tymy/${opp.id}/`)}>{opp.name}</a></span>
              </li>
            );
          })}</ul>
        : <EmptyState title="Zatím bez finále" text="Kapitola, na kterou redakce teprve čeká." icon="📖" />}
    </section>

    {teamRivalries.length > 0 && (
      <section class="stack">
        <SectionHead title="Rivality" href="sin-slavy/#rivality" linkLabel="Síň slávy" />
        {teamRivalries.map((r) => {
          const other = teamById(r.teams.find((id) => id !== team.id));
          return <p class="panel" style="margin:0"><strong>{r.title}:</strong> vs. <a href={u(`tymy/${other.id}/`)}>{other.name}</a></p>;
        })}
      </section>
    )}

    {team.status !== 'former' && (
      <section class="stack">
        <SectionHead title="Sezona V" accent="v číslech" />
        <EmptyState title="Redakce čeká na první kolo" text="Bilance a výsledky se objeví po prvním ověřeném fantasy kole." />
      </section>
    )}
  </div>
</Base>
