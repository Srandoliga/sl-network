---
import Base from '../../layouts/Base.astro';
import StaffCard from '../../components/StaffCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import EmptyState from '../../components/EmptyState.astro';
import { staffMembers } from '../../lib/data.js';
import { getArticles } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return staffMembers.map((person) => ({
    params: { id: person.id },
    props: { person, articles: articles.filter((a) => a.data.author === person.id) },
  }));
}
const { person, articles } = Astro.props;
---
<Base title={person.name} description={`${person.role}: ${person.beat}.`}>
  <div class="stack">
    <StaffCard person={person} link={false} headingLevel="h1" />
    <p class="kicker">Rubrika: {person.beat}</p>
    <section class="stack">
      <SectionHead title="Články" accent="autora" />
      {articles.length
        ? <ul class="article-list">{articles.map((a) => <li><ArticleCard article={a} /></li>)}</ul>
        : <EmptyState title="Zatím bez článku" text="Ladí formu. Prý." icon="✍️" />}
    </section>
  </div>
</Base>
